# Reference only: `npm run setup` creates agent/.env and fills in the seeds for you.
# TESTNET ONLY. Never put mainnet seeds in this file. agent/.env is gitignored.

XRPL_NETWORK=wss://s.altnet.rippletest.net:51233
# Standard currency codes are exactly 3 characters.
TOKEN_CURRENCY=TGD
TOKEN_ISSUER=
ISSUER_SEED=
TREASURY_SEED=
MM_SEED=

# --- Optional tuning (defaults shown) ---
# Best bid of the simulated book, XRP per token
# BASE_PRICE=0.0001
# Bid ladder: % below BASE_PRICE and size (tokens) of each level
# LADDER_DROPS_PCT=0,0.2,0.4,3,8,14,20,25,30,35
# LADDER_SIZES=10000,10000,10000,10000,10000,10000,10000,10000,10000,10000
# MM_INTERVAL_MS=1000
# DEMO_AMOUNT=100000
# MAX_SLIPPAGE_PCT=0.5
# CHUNK_MAX=20000
# PARTICIPATION=0.7
# MIN_CHUNK=100
# POLL_MS=1000
# LIQUIDITY_TIMEOUT_MS=30000
# TREASURY_MINT=1000000
